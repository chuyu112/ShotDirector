# 复制为 .env.server；绝不要把真实密钥提交到 Git。
# 公开模型目录和调用参数均从 env 读取；默认项必须写公开模型 ID。
MANJING_AI_PROVIDER=glm-5.3-flash
# 一般创作的默认推理档位；页面可按项目改为 low/high/max。
# 漫画拆图固定 low，逐 Shot 完整提示词与严格审核固定 max，不受此值影响。
MANJING_WRITING_REASONING_EFFORT=high
# GPT 图片能力仍独立使用 OPENAI_BASE_URL；文字模型使用下方 OPENAI_API_URL。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MANJING_OPENAI_IMAGE_MODEL=gpt-image-2
MANJING_OPENAI_IMAGE_QUALITY=medium

# 公网 HTTPS 必须为 true；仅本机 HTTP 联调可设 false。
MANJING_COOKIE_SECURE=true
MANJING_REGISTRATION_ENABLED=true
MANJING_MAX_ACTIVE_SESSIONS_PER_USER=8
MANJING_MAX_TENANT_WORKERS=32
MANJING_MAX_WORKERS_PER_USER=3
MANJING_MAX_PROJECTS_PER_USER=10
MANJING_WORKER_IDLE_TIMEOUT_MS=1200000
MANJING_WORKER_IDLE_SWEEP_INTERVAL_MS=60000
MANJING_WORKER_SHUTDOWN_WAIT_MS=900000
MANJING_WORKER_TERMINATE_TIMEOUT_MS=5000
MANJING_WORKER_KILL_TIMEOUT_MS=2000

# 漫画裁框也只走服务端 API，不使用个人 Codex/ChatGPT 登录额度。
MANJING_MANGA_CROP_MODEL=glm-5.3-flash

# LibTV 短信登录服务器级节流（会透传到租户 Worker）。
MANJING_LIBTV_SMS_COOLDOWN_MS=60000
MANJING_LIBTV_SMS_WINDOW_MS=900000
MANJING_LIBTV_SMS_MAX_PER_WINDOW=5

# 按账户和全服务器双重原子限额。0 表示默认不开放该付费能力，请先接好计费再调高。
# MANJING_DAILY_AI_REQUESTS / MANJING_DAILY_GLOBAL_AI_REQUESTS 是保守的上游模型调用预算单位，
# 不是浏览器 HTTP 请求次数；不同 AI 路由会按 1–10 个预算单位计费，详见部署文档。
MANJING_DAILY_AI_REQUESTS=10
MANJING_DAILY_SUPERADMIN_AI_REQUESTS=100
MANJING_DAILY_GLOBAL_AI_REQUESTS=200
MANJING_DAILY_IMAGE_REQUESTS=0
MANJING_DAILY_GLOBAL_IMAGE_REQUESTS=20
MANJING_DAILY_LIBTV_REQUESTS=0
MANJING_DAILY_GLOBAL_LIBTV_REQUESTS=0
MANJING_DAILY_LIBTV_LOGIN_ATTEMPTS=5
MANJING_DAILY_GLOBAL_LIBTV_LOGIN_ATTEMPTS=100
MANJING_DAILY_UPLOADS=100
MANJING_DAILY_GLOBAL_UPLOADS=2000
MANJING_DAILY_UPLOAD_BYTES=1073741824
MANJING_DAILY_GLOBAL_UPLOAD_BYTES=21474836480
MANJING_QUOTA_TIME_ZONE=Asia/Shanghai
MANJING_ALLOWED_ORIGINS=https://manjing.example.com
MANJING_TRUST_PROXY=true
MANJING_TRUST_PROXY_HOPS=1
MANJING_FFMPEG_BIN=/usr/local/bin/ffmpeg

# Docker 构建参数；升级版本时必须同时更新两个官方包的 SHA-256。
INSTALL_LIBTV=1
LIBTV_VERSION=1.1.3
LIBTV_SHA256_AMD64=cf86f462c5aed60f95dca978cc91ece98c60bcfa27337da008ad59953c3ea7da
LIBTV_SHA256_ARM64=369b43f5be1d28dbbde7c1b6711ed746bf9bff1028ba794a6dae4fa01bed601c

# 文字模型与独立 Reviewer 共用翠易 env 的变量名；密钥必须在部署环境单独注入。
KIMI_API_URL=https://api.kimi.com/coding/v1
KIMI_API_KEY=
KIMI_MODEL=k3
MANJING_KIMI_MAX_OUTPUT_TOKENS=16384
GLM_API_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
GLM_MODEL=glm-5.3
GLM_FLASH_MODEL=glm-5.3-flash
MANJING_GLM_MAX_OUTPUT_TOKENS=16384
# JK 文字模型全部走服务端 API。Responses 需要 /openai/v1，Chat 和 Claude 使用共享 Base URL。
JIEKOU_BASE_URL=https://api.highwayapi.ai/openai
JIEKOU_RESPONSES_BASE_URL=https://api.highwayapi.ai/openai/v1
JIEKOU_API_KEY=
MANJING_JIEKOU_MAX_OUTPUT_TOKENS=16384
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
MANJING_DEEPSEEK_MAX_OUTPUT_TOKENS=16384
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seed-2-1-pro-260628
MANJING_DOUBAO_MAX_OUTPUT_TOKENS=32768
