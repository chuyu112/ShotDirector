[Unit]
Description=Manjing authentication gateway and tenant workers
After=network-online.target manjing-web.service
Wants=network-online.target

[Service]
Type=simple
User=manjing
Group=manjing
WorkingDirectory=/opt/manjing
EnvironmentFile=/opt/manjing/.env.server
Environment=NODE_ENV=production
Environment=MANJING_GATEWAY_HOST=127.0.0.1
Environment=MANJING_GATEWAY_PORT=8180
Environment=MANJING_APP_ROOT=/opt/manjing
Environment=MANJING_DATA_ROOT=/var/lib/manjing
Environment=MANJING_PUBLIC_API_BASE=/api
Environment=MANJING_PYTHON=/usr/bin/python3
Environment=FFMPEG_PATH=/usr/local/bin/ffmpeg
Environment=LIBTV_BIN=/usr/local/bin/libtv
ExecStart=/usr/local/bin/node /opt/manjing/server/manjing-gateway.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=930
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/manjing
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
