{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "pages"],
  "properties": {
    "status": { "type": "string", "const": "completed" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scanIndex", "sourceFile", "boxes", "notes"],
        "properties": {
          "scanIndex": { "type": "integer", "minimum": 1 },
          "sourceFile": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" },
          "boxes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["tempId", "bounds", "role", "missingEdges", "detectionOrder", "readingOrder", "confidence", "rationale"],
              "properties": {
                "tempId": { "type": "string", "pattern": "^B[0-9]{2}$" },
                "bounds": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["x", "y", "width", "height"],
                  "properties": {
                    "x": { "type": "number", "minimum": 0, "maximum": 100 },
                    "y": { "type": "number", "minimum": 0, "maximum": 100 },
                    "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
                    "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
                  }
                },
                "role": { "type": "string", "enum": ["small", "regular", "outer"] },
                "missingEdges": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["top", "right", "bottom", "left"] }
                },
                "detectionOrder": { "type": "integer", "minimum": 1 },
                "readingOrder": { "type": "integer", "minimum": 1 },
                "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
                "rationale": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
